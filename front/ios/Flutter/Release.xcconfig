#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
// Home screen name of local builds, to tell them apart from TestFlight ones.
APP_DISPLAY_NAME = Dev Alzheimer
// Distribution settings (signing, app name), generated by the TestFlight
// workflow (absent locally). Only the Runner target uses this file, so the
// plugins' Swift packages are not given a provisioning profile.
#include? "Distribution.xcconfig"
